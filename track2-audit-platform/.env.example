# Replace placeholders locally; never commit credentials.
APP_NAME=AuditForge API
APP_ENV=development
LOG_LEVEL=INFO
DB_BACKEND=supabase
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3010,http://127.0.0.1:3010
DEMO_ADMIN_PASSWORD=change-this-demo-password
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
