# Replace placeholders locally; never commit real credentials or production secrets.
DB_BACKEND=supabase
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Application configuration
APP_NAME=AuditForge
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=<generate-a-secure-random-secret-key>

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
