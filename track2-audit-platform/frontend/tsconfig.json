{
 "compilerOptions": {
  "target": "ES2022",
  "lib": ["dom", "dom.iterable", "esnext"],
  "strict": true,
  "noEmit": true,
  "module": "esnext",
  "moduleResolution": "bundler",
  "jsx": "preserve",
  "resolveJsonModule": true,
  "isolatedModules": true,
  "baseUrl": ".",
  "paths": {"@/*": ["./src/*"]}
 },
 "include": ["src/**/*.ts", "src/**/*.tsx"],
 "exclude": ["node_modules"]
}
